# ==============================================================
# backend/.env  —  Copy this to backend/.env and fill in values
# ==============================================================

# Django
DEBUG=False
SECRET_KEY=change-this-to-a-long-random-string-at-least-50-chars

# Allowed hosts (comma-separated — include your server IP or domain)
ALLOWED_HOSTS=your-server-ip,yourdomain.com

# Database (must match db/.env values)
DB_NAME=eoms
DB_USER=eoms
DB_PASSWORD=change-this-strong-db-password
DB_HOST=db
DB_PORT=5432

# Redis / Celery broker
REDIS_URL=redis://redis:6379/0

# JWT lifetimes (in minutes)
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# File upload limit (bytes — 10 MB default)
MAX_UPLOAD_SIZE=10485760

# ==============================================================
# CORS / CSRF  (set to the URL users browse to)
# ==============================================================
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://your-server-ip,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=http://your-server-ip,https://yourdomain.com

# ==============================================================
# Email — Gmail SMTP
# Use an App Password (NOT your real password):
# https://myaccount.google.com/apppasswords
# ==============================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=EOMS <your-gmail@gmail.com>

# ==============================================================
# Africa's Talking SMS
# ==============================================================
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=your-africas-talking-api-key
AFRICAS_TALKING_SENDER_ID=EOMS
