# ============================================================
# EOMS Production Environment Variables
# ============================================================
# Copy this file to .env on your Kamatera server:  cp .env.production.example .env
# Edit all values marked with  <CHANGE_THIS>
# NEVER commit the actual .env file to git
# ============================================================

# ── Django Core ─────────────────────────────────────────────
DEBUG=False

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=<CHANGE_THIS_strong_random_secret_key>

# Comma-separated: your server IP, domain, and www variant
ALLOWED_HOSTS=<YOUR_SERVER_IP>,<YOUR_DOMAIN>,www.<YOUR_DOMAIN>

# ── CSRF & CORS ──────────────────────────────────────────────
# Comma-separated full origins (scheme + host + optional port)
CORS_ALLOWED_ORIGINS=http://<YOUR_SERVER_IP>,https://<YOUR_DOMAIN>,https://www.<YOUR_DOMAIN>
CORS_ALLOW_ALL_ORIGINS=False

# Comma-separated: required for Django admin + DRF with CSRF
CSRF_TRUSTED_ORIGINS=http://<YOUR_SERVER_IP>,https://<YOUR_DOMAIN>,https://www.<YOUR_DOMAIN>

# ── Database ─────────────────────────────────────────────────
DB_NAME=eoms
DB_USER=eoms
# Use a strong random password
DB_PASSWORD=<CHANGE_THIS_strong_db_password>
DB_HOST=db
DB_PORT=5432

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT Token Lifetimes (minutes) ────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# ── Email (Gmail SMTP) ───────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<YOUR_GMAIL_ADDRESS>
# Use a Gmail App Password (not your real password):
# Google Account → Security → 2-Step Verification → App passwords
EMAIL_HOST_PASSWORD=<YOUR_GMAIL_APP_PASSWORD>
DEFAULT_FROM_EMAIL=EOMS <noreply@eoms.com>

# ── Africa's Talking SMS (OTP fallback) ──────────────────────
AFRICAS_TALKING_USERNAME=<YOUR_AT_USERNAME>
AFRICAS_TALKING_API_KEY=<YOUR_AT_API_KEY>
AFRICAS_TALKING_SENDER_ID=EOMS

# ── File Uploads ─────────────────────────────────────────────
MAX_UPLOAD_SIZE=10485760
